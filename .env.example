# Copy to .env and fill in. Never commit .env (C16).
# This file lists every variable the application reads — no more, no fewer.

# --- database ---------------------------------------------------------------
# DATABASE_URL points at the pooled endpoint in production (append
# ?pgbouncer=true&connection_limit=1); DIRECT_DATABASE_URL is unpooled and used
# only by `prisma migrate` (C23).
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- auth -------------------------------------------------------------------
# AUTH_SECRET: 32+ chars, e.g. `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# --- secrets ----------------------------------------------------------------
# OTP_PEPPER: 32+ chars, e.g. `openssl rand -hex 32`. Rotating it invalidates
# every outstanding OTP challenge and every phoneHash log correlation (C19).
OTP_PEPPER=
CRON_SECRET=

# --- SMS --------------------------------------------------------------------
# SMS_PROVIDER: console | twilio. The TWILIO_* values are required only when
# SMS_PROVIDER=twilio (either a messaging service SID or a from-number).
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Daily SMS spend ceiling in minor units; breaching it stops sending (A6).
SMS_DAILY_CAP_MINOR=
# SMS_KILL_SWITCH: true | false — true halts all sending immediately (A6).
SMS_KILL_SWITCH=

# --- rate limiting ----------------------------------------------------------
# RATE_LIMIT_PROVIDER: memory | upstash. Production MUST use upstash: the memory
# limiter is per-instance and therefore only advisory on serverless (C14).
RATE_LIMIT_PROVIDER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- clinic -----------------------------------------------------------------
# CLINIC_TIMEZONE: IANA zone, e.g. Europe/Berlin. CLINIC_CURRENCY: ISO-4217,
# e.g. EUR. CLINIC_DEFAULT_COUNTRY: ISO-3166-1 alpha-2, the phone selector default.
CLINIC_TIMEZONE=
CLINIC_CURRENCY=
CLINIC_DEFAULT_COUNTRY=

# --- seed + ops -------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# E2E_TEST_HOOKS: true | false — true registers POST /api/test/reset, which must
# never be enabled in production (A6b).
E2E_TEST_HOOKS=
